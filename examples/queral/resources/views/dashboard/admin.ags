@page title="QUERAL Admin" robots="noindex,nofollow"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body>
    <div class="shell">
        <header class="hero">
            <div>
                <p class="eyebrow">Administrator workspace</p>
                <h1>QUERAL Admin</h1>
                <p class="lead">Use this page to confirm the local AGIDB-backed realtime test environment and return to the live communications app.</p>
            </div>
            <div class="hero-actions">
                <a class="button primary" href="/">Open realtime app</a>
                <a class="button" href="/dashboard">User dashboard</a>
                <form method="POST" action="/logout">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button class="button ghost" type="submit">Sign out</button>
                </form>
            </div>
        </header>

        <main class="layout">
            <section class="panel runtime-panel">
                <div class="panel-head">
                    <h2>Environment</h2>
                </div>
                <div class="status-grid">
                    <div><span>Auth store</span><strong>Ready</strong></div>
                    <div><span>Session store</span><strong>Ready</strong></div>
                    <div><span>Database path</span><strong>{{ database }}</strong></div>
                    <div><span>Deployment mode</span><strong>Local native runtime</strong></div>
                </div>
            </section>

            <aside class="panel notifications-panel">
                <div class="panel-head">
                    <h2>Admin Notes</h2>
                </div>
                <div class="notifications">
                    <div class="notification">WebRTC in this app is signaling-backed by default.</div>
                    <div class="notification">Full native media provider remains feature-gated in the framework.</div>
                    <div class="notification warn">Treat browser camera/mic success as live proof, not framework status JSON alone.</div>
                </div>
            </aside>
        </main>
    </div>
</body>
</html>
