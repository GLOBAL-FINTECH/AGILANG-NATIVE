@page title="QUERAL Meetings" robots="noindex,nofollow"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="QUERAL secure realtime meetings on AGILANG.">
    <title>QUERAL Meetings</title>
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body class="meeting-app">
    <section id="welcome-screen" class="landing" hidden>
        <header class="landing-nav">
            <a class="brand" href="/" aria-label="QUERAL home">
                <span class="brand-mark">Q</span>
                <span>QUERAL</span>
            </a>
            <div class="landing-actions">
                <a href="/dashboard" class="text-link">Dashboard</a>
                <a href="/logout" class="avatar-button" aria-label="Account">Q</a>
            </div>
        </header>
        <main class="landing-main">
            <div class="landing-copy">
                <span class="product-kicker">Secure meetings powered by AGILANG</span>
                <h1>Video meetings that start in one click.</h1>
                <p>Create a protected room, share one link, and connect video, audio, live chat, WebSocket presence, and authenticated WebRTC signaling.</p>
                <div class="landing-cta">
                    <button id="new-meeting" class="primary-action" type="button">New meeting</button>
                    <div class="join-code">
                        <input id="meeting-code" type="text" inputmode="numeric" placeholder="Enter meeting code" aria-label="Meeting code">
                        <button id="join-meeting" type="button">Join</button>
                    </div>
                </div>
            </div>
            <div class="landing-visual" aria-hidden="true">
                <div class="preview-tile main-preview"><span>Secure realtime video</span></div>
                <div class="preview-tile preview-one"><span>Live chat</span></div>
                <div class="preview-tile preview-two"><span>WebSocket presence</span></div>
            </div>
        </main>
    </section>

    <section id="meeting-screen" hidden>
        <div id="meeting-shell" class="meeting-shell">
            <header class="meeting-topbar">
                <div class="meeting-branding">
                    <a class="brand compact" href="/"><span class="brand-mark">Q</span><span>QUERAL</span></a>
                    <span class="top-divider"></span>
                    <div>
                        <strong id="meeting-id-label">Meeting</strong>
                        <span id="meeting-status" data-tone="ready">Preparing secure room…</span>
                    </div>
                </div>
                <div class="meeting-top-actions">
                    <span class="security-chip">Encrypted signaling</span>
                    <button id="copy-invite" class="top-button" type="button">Copy invite</button>
                    <button id="toggle-sidebar" class="top-button" type="button">Chat & people</button>
                </div>
            </header>

            <main class="meeting-workspace">
                <section class="stage-column">
                    <section id="prejoin-screen" class="prejoin-card">
                        <div class="prejoin-preview">
                            <video id="prejoin-video" autoplay muted playsinline></video>
                            <div class="prejoin-placeholder">Camera preview starts when you join</div>
                        </div>
                        <div class="prejoin-copy">
                            <span class="product-kicker">Ready to join?</span>
                            <h1 id="prejoin-title">Join your QUERAL meeting</h1>
                            <p>Your browser will ask for camera and microphone permission. After approval, QUERAL registers your authenticated peer and connects automatically.</p>
                            <div class="identity-card">
                                <span id="participant-name">Authenticated user</span>
                                <small id="participant-role">Participant</small>
                            </div>
                            <button id="join-now" class="primary-action wide" type="button">Join now</button>
                        </div>
                    </section>

                    <section id="live-room" class="live-room" hidden>
                        <div class="video-grid">
                            <article class="video-tile remote-tile">
                                <video id="remote-video" autoplay playsinline></video>
                                <div id="remote-placeholder" class="video-placeholder">
                                    <div class="participant-avatar">R</div>
                                    <strong id="remote-name">Waiting for participant</strong>
                                    <span>The remote video appears automatically after connection.</span>
                                </div>
                                <footer><span id="remote-caption">Remote participant</span><span id="remote-media-badge" class="media-badge">Waiting</span></footer>
                            </article>
                            <article class="video-tile local-tile">
                                <video id="local-video" autoplay muted playsinline></video>
                                <div id="local-placeholder" class="video-placeholder">
                                    <div class="participant-avatar">Y</div>
                                    <strong>You</strong>
                                </div>
                                <footer><span>You</span><span id="local-media-badge" class="media-badge">No media</span></footer>
                            </article>
                        </div>

                        <div class="meeting-toolbar" role="toolbar" aria-label="Meeting controls">
                            <button id="toggle-audio" class="control-button" type="button"><b>🎙</b><span>Mute</span></button>
                            <button id="toggle-video" class="control-button" type="button"><b>📹</b><span>Stop video</span></button>
                            <button class="control-button" type="button" disabled><b>▣</b><span>Share</span></button>
                            <button id="open-diagnostics" class="control-button" type="button"><b>•••</b><span>More</span></button>
                            <button id="leave-call" class="control-button leave" type="button"><b>↗</b><span>Leave</span></button>
                        </div>
                    </section>
                </section>

                <aside class="meeting-sidebar">
                    <nav class="sidebar-tabs">
                        <button class="active" type="button">Chat</button>
                        <button type="button">People <span id="peer-count">1</span></button>
                    </nav>
                    <section class="chat-panel">
                        <div id="chat-list" class="chat-list">
                            <div class="message system"><span>Messages are delivered automatically when the WebRTC data channel opens.</span></div>
                        </div>
                        <div class="chat-composer">
                            <input id="chat-input" type="text" autocomplete="off" placeholder="Message everyone">
                            <button id="chat-send" type="button" aria-label="Send message">➤</button>
                        </div>
                    </section>
                    <section class="activity-panel">
                        <header><strong>Live activity</strong><span id="socket-label">connecting</span></header>
                        <div id="activity-list" class="activity-list">
                            <div class="activity-item">Secure meeting workspace initialized.</div>
                        </div>
                    </section>
                </aside>
            </main>

            <footer class="connection-footer">
                <span>Signaling <b id="signal-label">idle</b></span>
                <span>Connection <b id="connection-label">idle</b></span>
                <span>ICE <b id="ice-label">idle</b></span>
                <span>Chat <b id="chat-state">offline</b></span>
            </footer>
        </div>
    </section>

    <input id="invite-link" type="hidden">

    <dialog id="diagnostics" class="diagnostics-dialog">
        <header><h2>Meeting diagnostics</h2><button id="close-diagnostics" type="button">Close</button></header>
        <p>Use this panel only for protocol validation. The meeting experience remains video-first.</p>
        <dl>
            <div><dt>Meeting</dt><dd id="diagnostic-meeting">Active AGILANG room</dd></div>
            <div><dt>Transport</dt><dd>Authenticated HTTP signaling, WebSocket activity, WebRTC media/data</dd></div>
            <div><dt>Template</dt><dd>AGS reactive meeting view</dd></div>
        </dl>
    </dialog>

    <script src="/assets/js/meeting.js" defer></script>
</body>
</html>
