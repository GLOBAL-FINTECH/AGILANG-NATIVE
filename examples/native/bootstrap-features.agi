fn factorial(n: i32) -> i32:
    let result: i32 = 1
    let i: i32 = 2

    while i <= n:
        result *= i
        i += 1

    return result

fn array_total(values: array) -> f64:
    let total: f64 = 0.0

    for value in values:
        total += value

    return total

fn main() -> i32:
    print("AGILANG Native Compiler Bootstrap Suite")
    print("")
    print("=== Language Features ===")
    print("Functions and typed parameters")
    print("Variables and constants")
    print("Conditional and loop control flow")
    print("Native arrays, indexing, append, length, and iteration")
    print("Modules, structs, enums, aliases, and classes")
    print("Native executable generation")
    print("")

    let values: array = [1.0, 2.0, 3.0]
    append(values, 4.0)
    values[0] = 10.0

    let factorial_result: i32 = factorial(5)
    let total: f64 = array_total(values)

    if factorial_result == 120 and len(values) == 4 and total == 19.0:
        return 0

    return 1
