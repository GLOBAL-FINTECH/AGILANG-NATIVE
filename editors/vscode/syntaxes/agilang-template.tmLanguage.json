{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AGILANG Reactive Template",
  "patterns": [
    {
      "include": "#tags"
    },
    {
      "include": "#comments"
    }
  ],
  "repository": {
    "tags": {
      "patterns": [{
        "name": "meta.tag.agilang",
        "match": "<[a-zA-Z0-9_\\-]+>"
      }]
    },
    "comments": {
      "patterns": [{
        "name": "comment.line.number-sign.agilang",
        "match": "#.*$"
      }]
    }
  },
  "scopeName": "source.ags"
}
